{
  "name": "@codechatter/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist", "drizzle"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./schema": { "types": "./dist/schema/index.d.ts", "default": "./dist/schema/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env ./dist/migrate.js",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@codechatter/config": "workspace:*",
    "@types/node": "^24",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3"
  }
}
