# CodeChatter — backend environment template
# Copy to .env.local and fill in real values. Never commit .env.local.

# ── Core ─────────────────────────────────────────────────────────────
# "development" or "production". In production the server refuses to
# start unless SECRET_KEY and SESSION_SECRET_KEY are set explicitly.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_SECRET_KEY=

JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7


# ── URLs / CORS ──────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Base URL of the frontend; OAuth redirects are built from this.
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=codechatter

# ── Runtime storage ──────────────────────────────────────────────────
# Absolute path for workspace snapshots and chat uploads.
# Defaults to server/data when unset.
CODECHATTER_DATA_DIR=

# ── Code execution ───────────────────────────────────────────────────
CODE_RUN_TIMEOUT_SECONDS=15

# ── OAuth (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── AI assistant (optional) ──────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# ── Email / MFA delivery (optional) ──────────────────────────────────
# Without SMTP the one-time codes are logged to the console, which is
# only allowed when ENVIRONMENT is not "production".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=5

# ── AI assistant ─────────────────────────────────────────────────────
# "ollama" runs an open-weights model on this machine (no key, no cost,
# no source code leaving the network). "gemini" uses the hosted API.
AI_PROVIDER=ollama

# Local model. Install Ollama, then: ollama pull qwen2.5-coder:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=120

# ── Mail ─────────────────────────────────────────────────────────────
# "gmail" sends via the Gmail API using the same Google Cloud project as
# sign-in. Enable the Gmail API in that project, add
# http://localhost:8765/ as an authorised redirect URI, then run:
#   python scripts/gmail_authorize.py
# "smtp" keeps the older path for any other mail host.
MAIL_PROVIDER=gmail
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
