# Production settings for infra/compose.yaml. On the server, copy this file to
# infra/.env.production (gitignored), fill in every value, and keep it private.

# Your domain. Its DNS A record must point at this server before the first start.
DOMAIN=codechatter.example.com
# Let's Encrypt account email (certificate problems are reported here).
ACME_EMAIL=you@example.com

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Signs tokens between the API, collab and the runner.
SERVICE_SECRET=

# Mail is required: sign-up sends a verification link. Gmail works for a small
# team (App Password, 500 emails a day); use Resend, Postmark or SES for more.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CodeChatter <you@example.com>"

# Sign in with Google / GitHub (optional; empty hides the button).
# Callback URLs: https://<DOMAIN>/api/auth/callback/google and .../github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Other origins allowed to use the app, comma-separated (usually empty).
EXTRA_ORIGINS=
