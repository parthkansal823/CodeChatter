        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(codechatter_http_requests_total{job=\"api\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(codechatter_http_requests_total{job=\"api\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx / all",
          "range": true,
          "editorMode": "code"
        }
      ]
