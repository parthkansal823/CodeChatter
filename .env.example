# CodeChatter v2 — shared server environment (apps/api, apps/collab, apps/worker,
# apps/runner, packages/db). Copy to `.env` at the repo root. Never commit `.env`.
# Next.js reads its own apps/web/.env.local (see apps/web/.env.example).

NODE_ENV=development

# Public origin (Caddy). Cookies, OAuth callbacks and Origin checks use this.
APP_URL=http://localhost:8080
# More origins allowed to use the app, comma-separated (e.g. a tunnel URL like
# https://abc.trycloudflare.com). In development, devices on your Wi-Fi
# (http://192.168.x.x:8080 and similar) are already allowed without this.
EXTRA_ORIGINS=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# 32-byte key for AES-GCM encryption of secrets at rest (base64url).
DATA_ENCRYPTION_KEY=

DATABASE_URL=postgres://codechatter:codechatter@localhost:15432/codechatter
VALKEY_URL=redis://localhost:16379

# Mail (Mailpit in dev: UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CodeChatter <no-reply@codechatter.local>"

# ── Real email through Gmail (uncomment and fill in, then restart the API) ──
# 1. Turn on 2-Step Verification for the Gmail account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Put the Gmail address and the 16-character App Password below.
# 4. Check it: pnpm --filter @codechatter/api mail:test you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=abcdefghijklmnop
# MAIL_FROM="CodeChatter <yourname@gmail.com>"

# Calls (video, voice, screen share) through LiveKit. In development these default to the
# dev stack's LiveKit (infra/livekit/livekit.dev.yaml); in production calls are off until
# all three are set: the address browsers reach LiveKit at, and its API key and secret.
# For production, copy these settings into infra/.env.production. Keep this block
# commented for development so the local server and its development key still match.
# Compose defaults the URL to wss://${DOMAIN}/livekit; use your real HTTPS domain.
# LIVEKIT_URL=wss://code.example.com/livekit
# LIVEKIT_API_KEY=codechatter-production
# Generate a separate secret: openssl rand -hex 32 (at least 32 characters; no spaces/newlines).
# LIVEKIT_API_SECRET=
# The same pair feeds the API and LiveKit's LIVEKIT_KEYS ("key: secret"). Never use the dev pair.
# Open TCP 7881 and UDP 7882/3478 directly to LiveKit, plus Caddy's TCP 80/443 and UDP 443.
# TURN/UDP helps NAT traversal; UDP-blocked networks need a separate TURN/TLS endpoint on TCP 443.

# Notification digest (optional): unread notifications are emailed after an hour, at
# most once a day per person; it looks every 15 minutes. Test accounts (.local and
# similar addresses) are only ever sent to a local mail catcher such as Mailpit.
# NOTIFICATION_DIGEST_CHECK_MS=900000
# NOTIFICATION_DIGEST_AFTER_MS=3600000
# NOTIFICATION_DIGEST_EVERY_MS=72000000

# OAuth (optional). Callback: {APP_URL}/api/auth/callback/{google|github}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Repository imports (New room > GitHub) use the GitHub API; set this only for GitHub Enterprise.
# GITHUB_API_URL=https://github.example.com/api/v3

# Object storage (SeaweedFS S3 in dev; any S3-compatible provider in prod)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=codechatter
S3_ACCESS_KEY=codechatter
S3_SECRET_KEY=codechatter-dev

# Production database backups (infra/compose.yaml). Local-only until the S3 URL
# and both dedicated credentials are set. Use an off-server private bucket/prefix.
# BACKUP_TZ=UTC
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=6
# BACKUP_S3_URL=s3://your-private-backups/codechatter
# BACKUP_S3_ENDPOINT=https://s3.your-provider.example
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_FORCE_PATH_STYLE=true

# Service ports (behind Caddy)
API_PORT=4000
COLLAB_PORT=4100

# Optional local monitoring (docker compose -f infra/compose.metrics.yaml up -d).
# This public development token matches Compose's scraper; use a unique secret in production.
# Unset: only TCP loopback may scrape in development; production denies all scrapes.
METRICS_TOKEN=codechatter-dev-metrics

# --- Runner (Run button and terminals; needs Docker) -------------------------
# Signs tokens between api, collab and runner. Generate like BETTER_AUTH_SECRET.
SERVICE_SECRET=
# Where the API reaches the runner, and the runner reaches collab (not via Caddy).
RUNNER_URL=http://127.0.0.1:4200
COLLAB_INTERNAL_URL=ws://127.0.0.1:4100
# Built by: pnpm sandbox:build
SANDBOX_IMAGE=codechatter-sandbox:dev
# With both of these, a room's owner can pick its image in the Ports panel (the sandbox
# restarts into it); a room that hasn't picked runs SANDBOX_IMAGE.
# SANDBOX_IMAGE_BASE=codechatter-sandbox:dev
# SANDBOX_IMAGE_FULL=codechatter-sandbox:full
# Limits per room sandbox.
SANDBOX_MEMORY_MB=768
SANDBOX_CPUS=1
SANDBOX_IDLE_MINUTES=15
# The full image (SANDBOX_IMAGE=codechatter-sandbox:full) wants more: its Kubernetes
# playground (k8s up) runs a real API server and etcd, whose Go threads count as processes.
# SANDBOX_MEMORY_MB=2048
# SANDBOX_PIDS=1024
# Each room's private network is a /26 of this range. Change it only if another Docker
# network on this machine already uses it.
# SANDBOX_SUBNET=10.213.0.0/16
# Where rooms run: "docker" (the default), or "kubernetes" (a namespace per room) on
# KUBE_CONTEXT, or the kubeconfig's current context. Volume sizes are for the latter.
# RUNNER_DRIVER=kubernetes
# KUBE_CONTEXT=docker-desktop
# SANDBOX_STORAGE_GB=5
# DATABASE_STORAGE_GB=2
# SANDBOX_STORAGE_CLASS=
# When pods look for a newer sandbox image: Always (picks up pnpm sandbox:build), or
# IfNotPresent for a pinned version.
# SANDBOX_IMAGE_PULL=Always

# AI copilot (apps/api/src/ai). Off by default; a bad value turns AI off with
# the reason shown in the AI panel, never stops the app. Pick one:
#   Free and private, Ollama in Docker: `pnpm ai:up` (or `pnpm ai:up:gpu` with an NVIDIA GPU),
#   then `pnpm ai:pull gemma4:e4b` (6.6 GB; needs about 8 GB of free memory).
#   With AI off, the AI panel lists the models your Ollama already has.
#     AI_PROVIDER=ollama
#     AI_MODEL=gemma4:e4b
#     AI_VISION=true                         (the model can read images; only for one that can)
#     AI_CONTEXT_CHARS=32000                 (fits OLLAMA_CONTEXT_LENGTH in infra/compose.dev.yaml)
#     OLLAMA_URL=http://localhost:11434      (from Docker: http://host.docker.internal:11434)
#     Without AI_CONTEXT_CHARS, Ollama gets 8000 characters of context; raise Ollama's
#     context length first, then AI_CONTEXT_CHARS.
#   Free tier, Google Gemini (API key from aistudio.google.com):
#     AI_PROVIDER=openai
#     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     OPENAI_API_KEY=...
#     AI_MODEL=gemini-2.5-flash
#   Claude (paid API key from console.anthropic.com):
#     AI_PROVIDER=anthropic
#     ANTHROPIC_API_KEY=...
#     AI_MODEL=claude-sonnet-5-5
#   Tests: the mock in apps/api/test/mock-ai.mjs (see its header).
AI_PROVIDER=none
# Requests per person per 10 minutes (the window is AI_RATE_WINDOW_SECONDS=600).
AI_RATE_LIMIT=30
# Inline completions (ghost text as you type) per person per minute, apart from the above.
AI_COMPLETE_RATE_LIMIT=30

# Diagrams use draw.io. By default the editor loads from embed.diagrams.net
# (diagrams stay in the room; draw.io's PDF export goes through its server).
# To keep everything on your own machine: docker run -d -p 8085:8080 jgraph/drawio
# NEXT_PUBLIC_DRAWIO_URL=http://localhost:8085
