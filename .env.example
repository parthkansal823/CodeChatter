# CodeChatter v2 — shared server environment (apps/api, apps/collab, apps/worker,
# apps/runner, packages/db). Copy to `.env` at the repo root. Never commit `.env`.
# Next.js reads its own apps/web/.env.local (see apps/web/.env.example).

NODE_ENV=development

# Public origin (Caddy). Cookies, OAuth callbacks and Origin checks use this.
APP_URL=http://localhost:8080
# More origins allowed to use the app, comma-separated (e.g. a tunnel URL like
# https://abc.trycloudflare.com). In development, devices on your Wi-Fi
# (http://192.168.x.x:8080 and similar) are already allowed without this.
EXTRA_ORIGINS=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# 32-byte key for AES-GCM encryption of secrets at rest (base64url).
DATA_ENCRYPTION_KEY=

DATABASE_URL=postgres://codechatter:codechatter@localhost:15432/codechatter
VALKEY_URL=redis://localhost:16379

# Mail (Mailpit in dev: UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CodeChatter <no-reply@codechatter.local>"

# ── Real email through Gmail (uncomment and fill in, then restart the API) ──
# 1. Turn on 2-Step Verification for the Gmail account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Put the Gmail address and the 16-character App Password below.
# 4. Check it: pnpm --filter @codechatter/api mail:test you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=abcdefghijklmnop
# MAIL_FROM="CodeChatter <yourname@gmail.com>"

# OAuth (optional). Callback: {APP_URL}/api/auth/callback/{google|github}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Object storage (SeaweedFS S3 in dev; any S3-compatible provider in prod)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=codechatter
S3_ACCESS_KEY=codechatter
S3_SECRET_KEY=codechatter-dev

# Service ports (behind Caddy)
API_PORT=4000
COLLAB_PORT=4100

# --- Runner (Run button and terminals; needs Docker) -------------------------
# Signs tokens between api, collab and runner. Generate like BETTER_AUTH_SECRET.
SERVICE_SECRET=
# Where the API reaches the runner, and the runner reaches collab (not via Caddy).
RUNNER_URL=http://127.0.0.1:4200
COLLAB_INTERNAL_URL=ws://127.0.0.1:4100
# Built by: pnpm sandbox:build
SANDBOX_IMAGE=codechatter-sandbox:dev
# Limits per room sandbox.
SANDBOX_MEMORY_MB=768
SANDBOX_CPUS=1
SANDBOX_IDLE_MINUTES=15
