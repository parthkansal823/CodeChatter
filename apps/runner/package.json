{
  "name": "@codechatter/runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "warm": "tsx --env-file-if-exists=../../.env scripts/warm.ts"
  },
  "dependencies": {
    "@codechatter/auth": "workspace:*",
    "@codechatter/contracts": "workspace:*",
    "@codechatter/workspace-model": "workspace:*",
    "@hocuspocus/provider": "4.7.0",
    "@kubernetes/client-node": "^2.0.0",
    "dockerode": "5.0.1",
    "ws": "8.21.3",
    "yjs": "13.6.33",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@codechatter/config": "workspace:*",
    "@types/dockerode": "4.0.1",
    "@types/node": "^24",
    "@types/ws": "8.18.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
