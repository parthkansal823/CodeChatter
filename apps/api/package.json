{
  "name": "@codechatter/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --enable-source-maps --env-file-if-exists=../../.env\"",
    "start": "node --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed:dev": "node --env-file-if-exists=../../.env dist/scripts/seed-dev.js",
    "mail:test": "node --env-file-if-exists=../../.env dist/scripts/mail-test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@codechatter/auth": "workspace:*",
    "@codechatter/contracts": "workspace:*",
    "@codechatter/db": "workspace:*",
    "@codechatter/emails": "workspace:*",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/platform-socket.io": "12.1.0",
    "@nestjs/websockets": "12.1.0",
    "@socket.io/redis-adapter": "8.3.0",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "ioredis": "^5",
    "nestjs-pino": "5.2.0",
    "nodemailer": "10.0.10",
    "openai": "7.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@codechatter/config": "workspace:*",
    "@nestjs/cli": "12.0.6",
    "@nestjs/testing": "12.1.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@types/express": "5.0.6",
    "@types/node": "^24",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.1",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.1"
  }
}
